# Copy to .env and fill in. Never commit the real .env file.

# --- Sophie core ---
SOPHIE_DATA_DIR=./data
SOPHIE_DEMO_MODE=true
SOPHIE_TIMEZONE=Europe/Helsinki

# --- LLM provider (OpenAI) ---
# If unset, Sophie runs on deterministic rules-only planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Microsoft Graph / Outlook (delegated) ---
# Register an app in Entra ID (Azure AD) with delegated permissions:
# Calendars.ReadWrite, User.Read. Public client / desktop redirect URI.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=http://localhost:8765/callback

# --- Weather provider ---
# Coarse, user-configured location only — never derived from GPS routes.
WEATHER_PROVIDER=open-meteo
WEATHER_LAT=
WEATHER_LON=
WEATHER_LOCATION_NAME=
