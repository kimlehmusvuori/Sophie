# Copy to .env and fill in. Never commit the real .env file.

# --- Sophie core ---
SOPHIE_DATA_DIR=./data
SOPHIE_DEMO_MODE=true
SOPHIE_TIMEZONE=Europe/Helsinki

# --- LLM providers ---
# The structured weekly coach plan uses OpenAI only. If unset, Sophie runs on
# deterministic rules-only planning either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# The free-form Chat page can use any of the three below — pick one as the
# default in Chat, or leave keys blank to leave that provider unavailable.
# Only the sanitized summaries described in docs/PRIVACY.md are ever sent —
# never raw Apple Health/Sports Tracker/clinical data — regardless of which
# provider you choose.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Microsoft Graph / Outlook (delegated) ---
# Register an app in Entra ID (Azure AD) with delegated permissions:
# Calendars.ReadWrite, User.Read. Public client / desktop redirect URI.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=http://localhost:8765/callback

# --- Weather provider ---
# Coarse, user-configured location only — never derived from GPS routes.
WEATHER_PROVIDER=open-meteo
WEATHER_LAT=
WEATHER_LON=
WEATHER_LOCATION_NAME=
